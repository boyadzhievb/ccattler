@startuml agent-call-graph
!theme plain
title Agent — Function Call Graph

' Agent.Run is the entry point. Every arrow means "calls".
' Goroutines are marked with (goroutine).

skinparam defaultTextAlignment left
skinparam componentBackgroundColor #f8f8f8
skinparam arrowColor #333333
left to right direction

() "Agent.Run" as run

' --- Startup sequence (sequential) ---
rectangle "Startup" {
  (RegisterNode) as regnode
  (PublishAliveState) as alive
  (WriteHeartbeat) as hb0
  (PublishAdvertiseAddress) as advaddr
  (EnsureSubnetPublished) as subnet
  (initializeDataPlaneIfSupported) as initdp
  (dnsForwarder.Start) as dnsfwd
  (executeReconciliationCycle) as reconcile0
}

run --> regnode
run --> alive
run --> hb0
run --> advaddr
run --> subnet
run --> initdp
run --> dnsfwd : goroutine
run --> reconcile0 : initial

' --- Goroutines spawned after startup ---
rectangle "Independent Goroutines" {
  (probeScheduler.Run) as probes
  (heartbeatLoop) as hbloop
  (dataPlaneLoop) as dploop
}

run --> probes : goroutine
run --> hbloop : goroutine
run --> dploop : goroutine

' --- Watch loop ---
rectangle "Watch Loop" {
  (runWatchLoop) as watchloop
  (executeReconciliationCycle) as reconcile
}

run --> watchloop : retry loop
watchloop --> reconcile : on ticker(1s) OR watch event

' === executeReconciliationCycle — the core ===
rectangle "executeReconciliationCycle" {
  (findInstancesPlacedOnThisNode) as findplaced
  (runtime.List) as rtlist
  (sort: no-init-step first) as sortinit
  (reconcileDesiredInstance) as recondesired
  (reconcileResourceChanges) as reconres
  (republishHostPortIfNeeded) as rehostport
  (observeInstanceState) as observe
  (publishInstanceStateToStore) as pubstate
  (detectConfigChange) as detectcfg
  (publishExitReasonFromStatus) as exitreason
  (cleanupUndesiredInstance) as cleanup
  (clearPullStatusFromStore) as clearpull
}

reconcile --> findplaced
reconcile --> rtlist
reconcile --> sortinit
reconcile --> recondesired : if NOT running
reconcile --> detectcfg : if running
reconcile --> reconres : if no config change
reconcile --> rehostport
reconcile --> observe
reconcile --> pubstate
reconcile --> exitreason : if exitCode != 0
reconcile --> cleanup : stale instances
reconcile --> clearpull : unplaced backoffs

' === findInstancesPlacedOnThisNode ===
rectangle "findInstancesPlacedOnThisNode" {
  (store.Scan placement/node/{nodeID}/) as scanplace
  (isInstanceMarkedForSkip) as skipcheck
  (store.Get observed/instance/{id}/state) as getstate
  (store.Get derived/drain/evict) as getdrain
  (store.Get observed/instance/{id}/service) as getsvc
  (derive service from ID) as derivesvc
}

findplaced --> scanplace
findplaced --> skipcheck
findplaced --> getstate
findplaced --> getdrain
findplaced --> getsvc
findplaced --> derivesvc : fallback for stateful IDs

' === isInstanceMarkedForSkip ===
rectangle "isInstanceMarkedForSkip" {
  (store.Get derived/instance/{id}/node_failure) as nodefail
  (store.Get derived/instance/{id}/controller_stopped) as ctrlstop
}

skipcheck --> nodefail
skipcheck --> ctrlstop

' === reconcileDesiredInstance — startup sequence ===
rectangle "reconcileDesiredInstance" {
  (lookupServiceImageFromStore) as lookupimg
  (resolveImagePullCredentials) as pullcreds
  (ensureImageAvailable) as ensureimg
  (RegisterInstanceToken) as regtok
  (hasInitSteps) as hasinit
  (executeInitializationSteps) as execinit
  (ensureVolumesAttachedForInstance) as volumes
  (publishStatusReason) as pubreason
  (buildRuntimeSpecForInstance) as buildspec
  (materializeSecretFiles) as matsecret
  (materializeConnectionFiles) as matconn
  (injectSecretAPIIntoSpec) as injectsecret
  (startInstanceAndPublishState) as startpub
}

recondesired --> lookupimg
recondesired --> pullcreds
recondesired --> ensureimg
recondesired --> regtok : if secretAPI
recondesired --> hasinit
recondesired --> execinit : if has init steps
recondesired --> volumes : if storageProvider
recondesired --> pubreason : "starting"
recondesired --> buildspec
recondesired --> matsecret
recondesired --> matconn
recondesired --> injectsecret : if secretAPI
recondesired --> startpub

' === ensureImageAvailable ===
rectangle "ensureImageAvailable" {
  (lookupServicePullPolicyFromStore) as pullpol
  (IsImageCached) as imgcache
  (PullImage) as pullimg
  (recordImagePullFailure) as pullbackoff
}

ensureimg --> pullpol
ensureimg --> imgcache
ensureimg --> pullimg : 5min timeout
ensureimg --> pullbackoff : on failure (10s-5min backoff)

' === executeInitializationSteps ===
rectangle "executeInitializationSteps" {
  (loadInitStepDefinitions) as loadinit
  (readCurrentInitPhase) as readphase
  (readInitStepState) as readstepst
  (executeInitStep) as execstep
  (clearInitProgress) as clearinit
}

execinit --> loadinit
execinit --> readphase
execinit --> readstepst
execinit --> execstep : for each step, sequential
execinit --> clearinit : all passed

' === executeInitStep ===
rectangle "executeInitStep" {
  (publishInitProgress) as initprog
  (runConnectionProbe) as connprobe
  (runInitCommand) as initcmd
}

execstep --> initprog
execstep --> connprobe : if connection type
execstep --> initcmd : if exec type

' === runConnectionProbe ===
rectangle "runConnectionProbe" {
  (assembleConnectionURL) as asmurl
  (parseConnectionJSON) as parseconn
  (resolveConnectionAddress) as resolveaddr
  (net.Dialer.DialContext) as tcpdial
}

connprobe --> asmurl
connprobe --> parseconn
connprobe --> resolveaddr : resolve hostname first
connprobe --> tcpdial : TCP dial resolved IP:port

' === resolveConnectionAddress ===
rectangle "resolveConnectionAddress" {
  (buildCCattlerResolver) as buildresolver
  (resolver.LookupHost) as lookuphost
}

resolveaddr --> buildresolver
resolveaddr --> lookuphost : explicit DNS lookup

note right of resolveaddr
  Bypasses Go net.Dialer.Resolver
  which CGo can override.
  Resolves hostname → IP first,
  then dials the IP directly.
end note

' === buildRuntimeSpecForInstance ===
rectangle "buildRuntimeSpecForInstance" {
  (resolveServiceConfigEnvVars) as resenv
  (resolveServiceConfigFiles) as rescfg
  (lookupServiceExposedPortsFromStore) as resports
  (lookupServiceResourcesFromStore) as resresrc
  (lookupServiceCommandFromStore) as rescmd
  (networkProvider.AllocateIP) as allocip
}

buildspec --> resenv
buildspec --> rescfg
buildspec --> resports
buildspec --> resresrc
buildspec --> rescmd
buildspec --> allocip

' === startInstanceAndPublishState ===
rectangle "startInstanceAndPublishState" {
  (runtime.Start) as rtstart
  (retryBridgeAttachmentIfNeeded) as retrybridge
  (executeLifecycleHook) as lifecycle
  (HostPortsForInstance) as hostports
  (publishInstanceHostPorts) as pubhostports
  (runtime.Status) as rtstatus
  (publishInstanceStateToStore2) as pubstate2
  (store.Put observed/instance/{id}/image) as putimage
}

startpub --> rtstart
startpub --> retrybridge
startpub --> lifecycle : post_start
startpub --> hostports
startpub --> pubhostports
startpub --> rtstatus
startpub --> pubstate2
startpub --> putimage

@enduml

@startuml server-call-graph
!theme plain
title Server (Controller Runner) — Function Call Graph

' Runner.Run is the entry point. Every arrow means "calls".

skinparam defaultTextAlignment left
skinparam componentBackgroundColor #f8f8f8
skinparam arrowColor #333333
left to right direction

() "Runner.Run" as run

' --- Startup ---
rectangle "Runner.Run" {
  (EventProjector.Run) as eventproj
  (runSingleController) as runsingle
}

run --> eventproj : goroutine
run --> runsingle : goroutine per controller

' === runSingleController ===
rectangle "runSingleController" {
  (runControllerLoop) as runloop
}

runsingle --> runloop : retry with exp backoff

' === runControllerLoop ===
rectangle "runControllerLoop" {
  (setupControllerWatches) as watches
  (executeReconciliationCycle) as reconcile0
  (runReconcileSelectLoop) as selectloop
}

runloop --> watches
runloop --> reconcile0 : initial reconcile
runloop --> selectloop

' === setupControllerWatches ===
rectangle "setupControllerWatches" {
  (store.Watch per prefix) as storewatch
  (forwardWatchEvents) as fwdevents
}

watches --> storewatch : for each controller.Watch() prefix
watches --> fwdevents : goroutine per prefix

' === runReconcileSelectLoop ===
rectangle "runReconcileSelectLoop" {
  (executeReconciliationCycle) as reconcile
}

note right of selectloop
  select:
    reconcileTrigger (watch event)
    resyncTicker (30s)
    watchLost → return error → restart
  debounce: 50ms after trigger
end note

selectloop --> reconcile : on trigger or resync

' === executeReconciliationCycle ===
rectangle "executeReconciliationCycle" {
  (attemptSingleReconciliation) as attempt
}

reconcile --> attempt : up to 5 retries on conflict

' === attemptSingleReconciliation ===
rectangle "attemptSingleReconciliation" {
  (store.Scan) as scan
  (controller.Reconcile) as recon
  (controller.ReconcileDelta) as recondelta
  (store.Transaction) as txn
}

attempt --> scan : read current facts
attempt --> recon : facts → []change
attempt --> recondelta : first attempt if delta
attempt --> txn : CAS commit (compare+then+else)

note right of txn
  Compare: input key revisions
  Then: put/delete changes
  Else: nil (retry on conflict)
end note

' === Controllers (14 core + 5 HA-only) ===
note bottom of run
  Core controllers:
    InstanceController, Scheduler,
    EndpointController, FailureController,
    AutoscaleController, IntentResolver,
    RolloutController, InitController,
    StatefulDNSController, StatefulVolumeController,
    RouteController, EvictionController,
    JobController, CronController

  HA-only (leader election):
    NodeFailureController, DrainController,
    NetworkController, NetworkPolicyController,
    WarmZeroController
end note

@enduml

@startuml fresh-deploy-call-sequence
!theme plain
title Fresh Deploy — Function Call Sequence (who calls whom, in order)

skinparam defaultTextAlignment left
skinparam noteBackgroundColor #ffffcc

participant "User" as user
participant "cca apply" as apply
participant "etcd" as etcd
participant "InstanceController\n.Reconcile()" as ic
participant "Scheduler\n.Reconcile()" as sched
participant "Agent\n.executeReconciliationCycle()" as agent
participant "Agent\n.reconcileDesiredInstance()" as startup
participant "Agent\n.executeInitializationSteps()" as init
participant "Container Runtime" as rt

== Step 1: User applies workload ==
user -> apply : cca apply airflow.cca
apply -> etcd : write desired/service/{name}/*

== Step 2: InstanceController creates instances ==
etcd -> ic : watch: desired/service/ changed
ic -> ic : Reconcile(facts) → changes[]
ic -> etcd : put observed/instance/{id}/state=pending\nput observed/instance/{id}/service={name}

== Step 3: Scheduler places instances on nodes ==
etcd -> sched : watch: observed/instance/ changed
sched -> sched : Reconcile(facts) → changes[]
sched -> etcd : put placement/instance/{id}={nodeID}\nput placement/node/{nodeID}/{id}=""

== Step 4: Agent reconcile loop picks up placement ==
etcd -> agent : watch: placement/node/{nodeID}/ changed
agent -> agent : findInstancesPlacedOnThisNode()
note right
  store.Scan(placement/node/{nodeID}/)
  → isInstanceMarkedForSkip()
  → store.Get(observed/instance/{id}/state)
  → store.Get(observed/instance/{id}/service)
end note
agent -> agent : runtime.List() → runningByID
agent -> agent : sort(no-init-step first)

== Step 5a: Instance WITHOUT init steps (e.g. metadata-db) ==
agent -> startup : reconcileDesiredInstance(metadata-db-0)
startup -> startup : lookupServiceImageFromStore()
startup -> startup : resolveImagePullCredentials()
startup -> startup : ensureImageAvailable()
note right
  lookupServicePullPolicyFromStore()
  → IsImageCached() → PullImage(5min timeout)
  → recordImagePullFailure() on error
end note
startup -> startup : hasInitSteps() → false
startup -> startup : buildRuntimeSpecForInstance()
note right
  resolveServiceConfigEnvVars()
  resolveServiceConfigFiles()
  lookupServiceExposedPortsFromStore()
  lookupServiceResourcesFromStore()
  lookupServiceCommandFromStore()
  networkProvider.AllocateIP()
end note
startup -> startup : materializeSecretFiles()
startup -> startup : materializeConnectionFiles()
startup -> rt : startInstanceAndPublishState()\n→ runtime.Start(spec)
rt --> startup : started, IP=10.x.y.z
startup -> etcd : publishInstanceStateToStore(running)
startup -> startup : retryBridgeAttachmentIfNeeded()
startup -> startup : executeLifecycleHook(post_start)

== Step 5b: Instance WITH init steps (e.g. worker) ==
agent -> startup : reconcileDesiredInstance(worker)
startup -> startup : lookupServiceImageFromStore()
startup -> startup : ensureImageAvailable()
startup -> startup : hasInitSteps() → true
startup -> init : executeInitializationSteps()
init -> init : loadInitStepDefinitions()
note right
  store.Scan(desired/service/{name}/init/)
  Parse each step: exec, connection, timeout, retry
end note
init -> init : readCurrentInitPhase()

loop for each init step (sequential)
  init -> init : readInitStepState()
  init -> init : executeInitStep()
  note right
    Check backoff (attemptCount, nextRetryAt)
    publishInitProgress()
  end note

  alt connection type
    init -> init : runConnectionProbe()
    note right
      assembleConnectionURL()
      parseConnectionJSON()
      resolveConnectionAddress()
        → buildCCattlerResolver()
        → resolver.LookupHost(hostname) → IP
      net.Dialer.DialContext("tcp", resolvedIP:port)
    end note
  else exec type
    init -> init : runInitCommand()
    note right
      runtime.ExecInit(image, initSpec)
    end note
  end
end

init --> startup : true (all steps passed)
startup -> startup : buildRuntimeSpecForInstance()
startup -> rt : startInstanceAndPublishState()
rt --> startup : started
startup -> etcd : publishInstanceStateToStore(running)

@enduml

@startuml dataplane-call-graph
!theme plain
title Data Plane — Function Call Graph

' DataPlaneReconciler.Reconcile is called every 1s from dataPlaneLoop.
' The provider dispatches to nftables, iptables, or eBPF.

skinparam defaultTextAlignment left
skinparam componentBackgroundColor #f8f8f8
skinparam arrowColor #333333
left to right direction

() "dataPlaneLoop (1s)" as dploop

rectangle "DataPlaneReconciler.Reconcile" {
  (buildServiceVIPConfigs) as buildvip
  (buildRouteDataPlaneConfigs) as buildroute
  (DataPlaneProvider.ReconcileVIPDataPlane) as reconcvip
  (DataPlaneProvider.ReconcileRouteDataPlane) as reconcroute
}

dploop --> buildvip
dploop --> reconcvip
dploop --> buildroute
dploop --> reconcroute

' === buildServiceVIPConfigs ===
rectangle "buildServiceVIPConfigs" {
  (store.Scan derived/vip/) as scanvip
  (store.Scan desired/service/*/ports) as scanports
  (resolveServiceBackends) as resvbackends
}

buildvip --> scanvip
buildvip --> scanports
buildvip --> resvbackends : for each service

' === resolveServiceBackends ===
rectangle "resolveServiceBackends" {
  (identifyStaleNodes) as stalenodes
  (resolveLocalBackend) as localbe
  (resolveRemoteBackend) as remotebe
}

resvbackends --> stalenodes
resvbackends --> localbe : if on this node
resvbackends --> remotebe : if on another node

' === NftablesDataPlane.ReconcileVIPDataPlane ===
rectangle "NftablesDataPlane (nftables path)" {
  (ensureDummyInterface) as nftdummy
  (ensureVIPAddress) as nftvipaddr
  (removeStaleVIPAddresses) as nftrmvip
  (buildVIPRuleset) as nftbuild
  (applyNftablesRuleset) as nftapply
}

reconcvip --> nftdummy : creates cca-vip0
reconcvip --> nftvipaddr : for each VIP
reconcvip --> nftrmvip
reconcvip --> nftbuild
reconcvip --> nftapply : nft -f (atomic)

' === buildVIPRuleset internals ===
rectangle "buildVIPRuleset" {
  (writePostRoutingChain) as postrt
  (writeVerdictMapWithElements) as vmap
  (writeBackendDNATRules) as dnat
}

nftbuild --> postrt
nftbuild --> vmap
nftbuild --> dnat

note bottom of nftdummy
  Creates cca-vip0 (dummy interface)
  for kernel to accept VIP packets.
  CNI bridge is separate: cca0.
end note

@enduml

@startuml vxlan-call-graph
!theme plain
title VXLAN Overlay — Function Call Graph

skinparam defaultTextAlignment left
skinparam componentBackgroundColor #f8f8f8
skinparam arrowColor #333333
left to right direction

() "dataPlaneLoop (1s)" as dploop

rectangle "VXLANReconciler.Reconcile" {
  (EnsureSubnetPublished) as ensuresub
  (ensureVXLANInterfaceExists) as ensurevxlan
  (discoverPeerNodes) as discover
  (programPeerRoutes) as progroutes
  (removeStaleRoutes) as rmroutes
}

dploop --> ensuresub
dploop --> ensurevxlan
dploop --> discover
dploop --> progroutes
dploop --> rmroutes

' === EnsureSubnetPublished ===
rectangle "EnsureSubnetPublished" {
  (allocateNextFreeSubnet) as allocsub
  (store.Put observed/node/{nodeID}/subnet) as putsub
}

ensuresub --> allocsub : if not yet assigned
ensuresub --> putsub

' === allocateNextFreeSubnet ===
rectangle "allocateNextFreeSubnet" {
  (store.Scan observed/node/*/subnet) as scansub
  (parseClusterCIDRBaseOctets) as parsecidr
  (collectOccupiedThirdOctets) as occupied
  (findNextFreeThirdOctetForNode) as nextoct
  (hashNodeIDToOctetOffset) as hashoct
}

allocsub --> scansub
allocsub --> parsecidr
allocsub --> occupied
allocsub --> nextoct
nextoct --> hashoct

' === ensureVXLANInterfaceExists ===
rectangle "ensureVXLANInterfaceExists" {
  (interfaceAlreadyExists) as ifexist
  (detectPhysicalInterfaceForAddress) as detectphy
  (deriveVXLANMACAddress) as derivemac
  (executeVXLANCreate) as vxlancreate
  (executeIPLinkSetUp) as linkup
}

ensurevxlan --> ifexist
ensurevxlan --> detectphy
ensurevxlan --> derivemac
ensurevxlan --> vxlancreate : ip link add cca-vxlan0 type vxlan
ensurevxlan --> linkup

' === discoverPeerNodes ===
rectangle "discoverPeerNodes" {
  (store.Scan observed/node/*/address) as scanaddr
  (store.Scan observed/node/*/subnet) as scanpeersub
  (buildNodeAddressMap) as addrmap
  (buildNodeSubnetMap) as submap
}

discover --> scanaddr
discover --> scanpeersub
discover --> addrmap
discover --> submap

' === programPeerRoutes ===
rectangle "programPeerRoutes" {
  (bridge fdb append) as fdbappend
  (ip route replace) as routeadd
}

progroutes --> fdbappend : VTEP → peer address
progroutes --> routeadd : peer subnet → vxlan0

@enduml

@startuml dns-call-graph
!theme plain
title DNS — Function Call Graph

skinparam defaultTextAlignment left
skinparam componentBackgroundColor #f8f8f8
skinparam arrowColor #333333
left to right direction

' === Control plane DNS server ===
() "DNSServer.Start (ctrl :15353)" as dnsstart

rectangle "DNSServer" {
  (handleDNSQuery) as handleq
  (parseDNSQuestionName) as parsename
  (StoreBackedResolver.ResolveEndpoints) as resolve
  (buildDNSARecordResponse) as buildresp
  (sendNXDomainResponse) as nxdomain
}

dnsstart --> handleq : for each UDP packet
handleq --> parsename
handleq --> resolve
handleq --> buildresp : if found
handleq --> nxdomain : if not found

' === Agent DNS forwarder ===
() "DNSForwarder.Start (agent :53)" as fwdstart

rectangle "DNSForwarder" {
  (handleForwardedQuery) as handlefwd
  (dnsCache.get) as cacheget
  (forwardToUpstream ccaUpstream) as fwdcca
  (forwardToUpstream systemUpstream) as fwdsys
  (dnsCache.put) as cacheput
}

fwdstart --> handlefwd : for each UDP packet
handlefwd --> cacheget : return cached if hit
handlefwd --> fwdcca : if *.cca.local
handlefwd --> fwdsys : else (system DNS)
handlefwd --> cacheput : cache response

' === StoreBackedResolver ===
rectangle "StoreBackedResolver" {
  (store.Scan derived/endpoint/{svc}/) as scanep
  (store.Get derived/vip/{svc}) as getvip
}

resolve --> scanep

note bottom of fwdcca
  Forwards .cca.local queries
  to control plane :15353.
  System queries go to /etc/resolv.conf
  upstream (parsed at startup).
end note

@enduml
