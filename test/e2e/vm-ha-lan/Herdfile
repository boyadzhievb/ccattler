images:
  debian:trixie: https://cloud.debian.org/images/cloud/trixie/latest/debian-13-genericcloud-amd64.qcow2

# Bridged HA cluster on testbed-100.77 (3 control-plane + 1 worker) for HA
# checks such as root key rotation (M178). Static addresses .53-.56 from the
# reserved range 192.168.100.50-.60; the e2e set (vm-lan) uses .50-.52.
# Memory: 3 x 3 GB + 2 GB = 11 GB on a 16 GB host — stop the vm-lan set and
# the ccattler runner first (design/TESTING.md "HA cluster on testbed-100.77").
vms:
  - name: cca-ha-lan-ctrl-1
    image: debian:trixie
    cpus: 2
    memory: 3072
    disk: 20G
    console_log: true
    shared_folders: []
    network:
      ip: 192.168.100.53

  - name: cca-ha-lan-ctrl-2
    image: debian:trixie
    cpus: 2
    memory: 3072
    disk: 20G
    console_log: true
    shared_folders: []
    network:
      ip: 192.168.100.54

  - name: cca-ha-lan-ctrl-3
    image: debian:trixie
    cpus: 2
    memory: 3072
    disk: 20G
    console_log: true
    shared_folders: []
    network:
      ip: 192.168.100.55

  - name: cca-ha-lan-worker-1
    image: debian:trixie
    cpus: 2
    memory: 2048
    disk: 20G
    console_log: true
    shared_folders: []
    network:
      ip: 192.168.100.56

network:
  type: bridge
  bridge: br1
  gateway: 192.168.100.1
  subnet: 192.168.100.0/24
  dns: 192.168.100.1

ssh:
  user: vmherd
