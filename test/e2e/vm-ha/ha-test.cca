service "whoami" {
  image "{{ default "docker.io" .registry }}/whoami:v1.10"
  instances 3
  port 80

  resources {
    cpu 100
    memory 67108864
  }
}

service "whoami-multiport" {
  image "{{ default "docker.io" .registry }}/whoami:v1.10"
  instances 2
  port 80
  port 8081

  resources {
    cpu 100
    memory 67108864
  }
}
