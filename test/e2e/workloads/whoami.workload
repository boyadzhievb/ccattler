# Workload manifest for whoami test service.
# Sourced by cluster_test.sh to discover deployment requirements.

WORKLOAD_DESCRIPTION="Whoami echo server (2 instances, HTTP health check)"
WORKLOAD_IMAGES=("traefik/whoami:latest")
WORKLOAD_EXPECTED_CONTAINERS=2
WORKLOAD_SECRETS=()

# Caddy reverse proxy: external_port → service_name:internal_port
WORKLOAD_EXPOSE=("8082:whoami:80")
