# Workload manifest for Zabbix monitoring stack.
# Sourced by cluster_test.sh to discover deployment requirements.

WORKLOAD_DESCRIPTION="Zabbix monitoring (postgres + server + web frontend)"
WORKLOAD_IMAGES=("${LOCAL_REGISTRY}/postgres:16" "${LOCAL_REGISTRY}/zabbix-server-pgsql:alpine-7.4-latest" "${LOCAL_REGISTRY}/zabbix-web-nginx-pgsql:alpine-7.4-latest")
WORKLOAD_EXPECTED_CONTAINERS=3
WORKLOAD_SECRETS=()

# Caddy reverse proxy: domain → service_name (all on port 443 with TLS).
WORKLOAD_EXPOSE=("zabbix.home.arpa:zabbix-web")
