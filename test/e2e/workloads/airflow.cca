# Apache Airflow CeleryExecutor stack for e2e testing.
#
# Validates the command directive, multi-role image deployment,
# and inter-service networking (webserver → postgres, worker → redis).

service metadata-db {
    image postgres:16
    instances 1
    expose 5432
    resources {
        cpu 500m
        memory 512Mi
    }
    config {
        env POSTGRES_DB "airflow"
        env POSTGRES_USER "airflow"
        env POSTGRES_PASSWORD "airflow"
    }
    health {
        tcp
        every 10s
    }
}

service redis {
    image redis:7
    instances 1
    expose 6379
    resources {
        cpu 250m
        memory 256Mi
    }
    health {
        tcp
        every 10s
    }
}

service webserver {
    image "apache/airflow:2.10.5"
    command "airflow webserver"
    instances 1
    expose 8080
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
    }
    health {
        tcp
        every 15s
    }
}

service scheduler {
    image "apache/airflow:2.10.5"
    command "airflow scheduler"
    instances 1
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
    }
    health {
        tcp
        every 30s
    }
}

service worker {
    image "apache/airflow:2.10.5"
    command "airflow celery worker"
    instances 2
    expose 8793
    resources {
        cpu 1000m
        memory 2048Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
    }
    health {
        tcp
        every 15s
    }
}
