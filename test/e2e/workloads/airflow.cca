connection airflow-db {
    driver "postgresql+psycopg2"
    user airflow
    secret airflow.db-password
    host metadata-db
    port 5432
    database airflow
}

connection airflow-celery-backend {
    driver "db+postgresql"
    user airflow
    secret airflow.db-password
    host metadata-db
    port 5432
    database airflow
}

service metadata-db {
    image "{{ default "docker.io" .registry }}/postgres:16"
    instances 1
    expose 5432
    health {
        tcp
        every 10s
    }
    resources {
        cpu 500m
        memory 512Mi
    }
    config {
        env POSTGRES_DB airflow
        env POSTGRES_USER airflow
        env POSTGRES_PASSWORD_FILE "/run/secrets/db-password"
    }
    secret airflow.db-password "/run/secrets/db-password"
}

service redis {
    image "{{ default "docker.io" .registry }}/redis:7"
    instances 1
    expose 6379
    health {
        tcp
        every 10s
    }
    resources {
        cpu 250m
        memory 256Mi
    }
}

service webserver {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command webserver
    instances 1
    expose 8080
    health {
        tcp
        every 15s
    }
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES true
        env _AIRFLOW_DB_MIGRATE true
        env _AIRFLOW_WWW_USER_CREATE true
        env _AIRFLOW_WWW_USER_PASSWORD_CMD "cca-secret airflow.admin-password"
    }
    secret airflow.admin-password "/run/secrets/admin-password"
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

service scheduler {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command scheduler
    instances 1
    health {
        tcp
        every 30s
    }
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES true
    }
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

service worker {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command "celery worker"
    instances 2
    expose 8793
    health {
        tcp
        every 15s
    }
    resources {
        cpu 1000m
        memory 2048Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES true
    }
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

gate airflow {
    host airflow.home.arpa
    service webserver port 8080
}
