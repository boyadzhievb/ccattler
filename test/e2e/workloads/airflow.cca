connection airflow-db {
    driver "postgresql+psycopg2"
    user airflow
    secret airflow.db-password
    host metadata-db
    port 5432
    database airflow
}

connection airflow-celery-backend {
    driver "db+postgresql"
    user airflow
    secret airflow.db-password
    host metadata-db
    port 5432
    database airflow
}

volume pgdata {
    size 10Gi
    persistent true
}

volume redisdata {
    size 1Gi
    persistent true
}

service metadata-db {
    image "{{ default "docker.io" .registry }}/postgres:16"
    instances 1
    expose 5432
    health {
        tcp
        every 10s
    }
    resources {
        cpu 500m
        memory 512Mi
    }
    config {
        env POSTGRES_DB airflow
        env POSTGRES_USER airflow
        env POSTGRES_PASSWORD_FILE "/run/secrets/db-password"
    }
    secret airflow.db-password "/run/secrets/db-password"
    volume pgdata /var/lib/postgresql/data
}

service redis {
    image "{{ default "docker.io" .registry }}/redis:7"
    instances 1
    expose 6379
    health {
        tcp
        every 10s
    }
    resources {
        cpu 250m
        memory 256Mi
    }
    volume redisdata /data
}

service webserver {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command "airflow webserver"
    instances 1
    expose 8080
    init {
        connection airflow-db
    }
    init {
        exec "airflow db migrate"
        timeout 300s
        retry 3
    }
    init {
        exec "airflow users create --username admin --firstname Admin --lastname User --role Admin --email admin@example.com --password $(cat /run/secrets/admin-password)"
        timeout 60s
        retry 3
    }
    startup {
        http /health
        port 8080
        every 10s
        timeout 20s
        failure_threshold 60
        initial_delay 60s
    }
    liveness {
        http /health
        port 8080
        every 10s
        timeout 5s
        failure_threshold 5
        initial_delay 15s
    }
    readiness {
        http /health
        port 8080
        every 10s
        timeout 5s
        failure_threshold 10
        initial_delay 30s
    }
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__WEBSERVER__BASE_URL "https://airflow.home.arpa"
        env AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX true
        env AIRFLOW__CORE__LOAD_EXAMPLES true
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
    }
    secret airflow.admin-password "/run/secrets/admin-password"
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    secret airflow.fernet-key "/run/secrets/fernet-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

service scheduler {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command "airflow scheduler"
    instances 1
    startup {
        exec "airflow jobs check --job-type SchedulerJob --local"
        every 10s
        timeout 20s
        failure_threshold 60
        initial_delay 60s
    }
    liveness {
        exec "airflow jobs check --job-type SchedulerJob --local"
        every 60s
        timeout 20s
        failure_threshold 5
        initial_delay 10s
    }
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES true
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
    }
    init {
        connection airflow-db
    }
    init {
        exec "airflow db check-migrations"
        timeout 120s
        retry 30
    }
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    secret airflow.fernet-key "/run/secrets/fernet-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

service worker {
    image "{{ default "docker.io" .registry }}/airflow:2.10.5"
    command "celery worker"
    instances 2
    expose 8793
    termination_grace_period 600s
    init {
        connection airflow-db
    }
    init {
        exec "airflow db check-migrations"
        timeout 120s
        retry 30
    }
    startup {
        exec "celery --app airflow.providers.celery.executors.celery_executor.app inspect ping -d celery@$(hostname)"
        every 10s
        timeout 10s
        failure_threshold 60
        initial_delay 60s
    }
    liveness {
        exec "celery --app airflow.providers.celery.executors.celery_executor.app inspect ping -d celery@$(hostname)"
        every 60s
        timeout 20s
        failure_threshold 5
        initial_delay 30s
    }
    resources {
        cpu 1000m
        memory 2048Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR CeleryExecutor
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES true
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
    }
    secret airflow.webserver-secret-key "/run/secrets/webserver-secret-key"
    secret airflow.fernet-key "/run/secrets/fernet-key"
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
}

gate airflow {
    host airflow.home.arpa
    service webserver port 8080
}
