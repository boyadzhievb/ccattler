service whoami-multiport {
    image "traefik/whoami:latest"
    instances 2
    expose 80
    expose 8081
    health {
        http /health
        every 10s
    }
    resources {
        cpu 100m
        memory 64Mi
    }
}

route whoami-multiport {
    host whoami-multiport.home.arpa
    service whoami-multiport port 80
}
