service metadata-db {
    image postgres:16
    instances 1
    expose 5432
    resources {
        cpu 500m
        memory 512Mi
    }
    config {
        env POSTGRES_DB "airflow"
        env POSTGRES_USER "airflow"
        env POSTGRES_PASSWORD "airflow"
    }
    health {
        tcp
        every 10s
    }
    init {
        exec "pg_isready -U airflow"
        timeout 60s
        retry 10
    }
}

service redis {
    image redis:7
    instances 1
    expose 6379
    resources {
        cpu 250m
        memory 256Mi
    }
    health {
        tcp
        every 10s
    }
}

service webserver {
    image "apache/airflow:2.10.5"
    command "airflow webserver --port 443 --ssl-cert /opt/airflow/certs/tls.crt --ssl-key /opt/airflow/certs/tls.key"
    instances 1
    expose 443
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__WEBSERVER__WEB_SERVER_PORT "443"
        env AIRFLOW__WEBSERVER__WEB_SERVER_SSL_CERT "/opt/airflow/certs/tls.crt"
        env AIRFLOW__WEBSERVER__WEB_SERVER_SSL_KEY "/opt/airflow/certs/tls.key"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
    }
    secret airflow-tls-cert "/opt/airflow/certs/tls.crt"
    secret airflow-tls-key "/opt/airflow/certs/tls.key"
    secret fernet-key "/opt/airflow/fernet-key"
    health {
        tcp
        every 15s
    }
    init {
        exec "airflow db migrate"
        timeout 120s
        retry 5
    }
    init {
        exec "airflow users create --username airflow --password airflow --firstname Admin --lastname User --role Admin --email admin@example.com"
        timeout 30s
        retry 3
    }
}

service scheduler {
    image "apache/airflow:2.10.5"
    command "airflow scheduler"
    instances 1
    resources {
        cpu 500m
        memory 1024Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
    }
    secret fernet-key "/opt/airflow/fernet-key"
    health {
        tcp
        every 30s
    }
}

service worker {
    image "apache/airflow:2.10.5"
    command "airflow celery worker"
    instances 2
    expose 8793
    resources {
        cpu 1000m
        memory 2048Mi
    }
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN "postgresql+psycopg2://airflow:airflow@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND "db+postgresql://airflow:airflow@metadata-db:5432/airflow"
    }
    secret fernet-key "/opt/airflow/fernet-key"
    health {
        tcp
        every 15s
    }
}
