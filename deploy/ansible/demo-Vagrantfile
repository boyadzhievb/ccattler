# -*- mode: ruby -*-
# CCattler demo cluster — libvirt/KVM on Linux.
#
# Prerequisite: vagrant plugin install vagrant-libvirt

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"

  config.vm.define "cca-demo-ctrl" do |node|
    node.vm.hostname = "cca-demo-ctrl"
    node.vm.network "private_network", ip: "192.168.56.10"
    node.vm.provider "libvirt" do |lv|
      lv.driver = "kvm"
      lv.memory = 2048
      lv.cpus   = 2
    end
  end

  config.vm.define "cca-demo-worker" do |node|
    node.vm.hostname = "cca-demo-worker"
    node.vm.network "private_network", ip: "192.168.56.20"
    node.vm.provider "libvirt" do |lv|
      lv.driver = "kvm"
      lv.memory = 2048
      lv.cpus   = 2
    end
  end
end
