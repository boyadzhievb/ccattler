# Systemd drop-in for etcd HA cluster — overrides single-node defaults.
# Generated by CCattler HA Ansible role. Named zz-cluster.conf so it sorts
# after cca init's tls.conf, which also resets ExecStart and sets ETCD_*
# variables; etcd refuses a variable shadowed by a flag, so they are unset.
[Service]
UnsetEnvironment=DAEMON_ARGS ETCD_NAME ETCD_DATA_DIR ETCD_LISTEN_CLIENT_URLS ETCD_ADVERTISE_CLIENT_URLS ETCD_CERT_FILE ETCD_KEY_FILE ETCD_TRUSTED_CA_FILE ETCD_CLIENT_CERT_AUTH
ExecStart=
ExecStart=/usr/bin/etcd \
  --name {{ inventory_hostname }} \
  --data-dir /var/lib/etcd \
  --listen-client-urls https://{{ ansible_host }}:2379,https://127.0.0.1:2379 \
  --advertise-client-urls https://{{ ansible_host }}:2379 \
  --listen-peer-urls https://{{ ansible_host }}:2380 \
  --initial-advertise-peer-urls https://{{ ansible_host }}:2380 \
  --initial-cluster {{ etcd_initial_cluster }} \
  --initial-cluster-token {{ etcd_cluster_token | default('ccattler-etcd') }} \
  --initial-cluster-state new \
  --client-cert-auth \
  --trusted-ca-file {{ cca_cert_dir }}/ca.pem \
  --cert-file {{ cca_cert_dir }}/etcd.pem \
  --key-file {{ cca_cert_dir }}/etcd-key.pem \
  --peer-client-cert-auth \
  --peer-trusted-ca-file {{ cca_cert_dir }}/ca.pem \
  --peer-cert-file {{ cca_cert_dir }}/etcd.pem \
  --peer-key-file {{ cca_cert_dir }}/etcd-key.pem
