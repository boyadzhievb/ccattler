# Generated by the CCattler etcd-cluster role (M280 SA-L1). Every node holds a
# client certificate from the etcd access CA, which etcd's peer port also
# accepts, so only the etcd members may reach 2380/tcp. Loaded by
# ccattler-etcd-peer-firewall.service; the first two lines make reloading idempotent.
table inet ccattler_etcd_peers
delete table inet ccattler_etcd_peers
table inet ccattler_etcd_peers {
  chain input {
    type filter hook input priority filter; policy accept;
    tcp dport 2380 ip saddr != { {% for member in groups['etcd'] %}{{ hostvars[member].ansible_host }}{{ ", " if not loop.last }}{% endfor %} } drop
  }
}
