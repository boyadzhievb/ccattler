[Unit]
Description=CCattler Agent — node {{ node_id | default(inventory_hostname) }}
After=network.target containerd.service
Requires=containerd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cca agent \
  --node-id {{ node_id | default(inventory_hostname) }} \
  --advertise-address {{ ansible_host }} \
  --cluster-cidr {{ cluster_cidr }} \
  --proxy --proxy-listen {{ ansible_host }}:{{ proxy_port | default(8080) }} \
  --debug-listen {{ ansible_host }}:9771 \
  --secret-api-listen {{ ansible_host }}:9772 \
  --cert {{ cca_cert_dir }}/node.pem \
  --key {{ cca_cert_dir }}/node-key.pem \
  --ca {{ cca_cert_dir }}/ca.pem \
  --etcd-cert {{ cca_cert_dir }}/node.pem \
  --etcd-key {{ cca_cert_dir }}/node-key.pem \
  --etcd-ca {{ cca_cert_dir }}/ca.pem \
  --network-mode {{ network_mode | default('local') }} \
  --dataplane {{ dataplane_backend | default('auto') }} \
  --dns-upstream {{ hostvars[groups['controlplane'][0]].ansible_host }}:15353{% if storage_backend is defined %} \
  --storage-backend {{ storage_backend }} \
  --storage-dir {{ storage_directory }}{% endif %}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cca-agent

[Install]
WantedBy=multi-user.target
