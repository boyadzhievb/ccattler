[Unit]
Description=CCattler Server — {{ inventory_hostname }} (HA)
After=network.target etcd.service
Requires=etcd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cca server \
  --listen {{ ansible_host }}:9770 \
  --node-id {{ inventory_hostname }} \
  --tls \
  --cert {{ cca_cert_dir }}/node.pem \
  --key {{ cca_cert_dir }}/node-key.pem \
  --ca {{ cca_cert_dir }}/ca.pem \
  --cluster-cidr {{ cluster_cidr }} \
  --vip-cidr {{ vip_cidr }}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cca-server

[Install]
WantedBy=multi-user.target
