[Unit]
Description=CCattler Server — {{ inventory_hostname }} (HA)
After=network.target etcd.service
# Wants, not Requires: Requires stops cca-server whenever the local etcd
# stops and never starts it again; cca-server reaches the other etcd members
# and retries on its own (found by the M219 HA run, check 9).
Wants=etcd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cca server \
  --listen {{ ansible_host }}:9770 \
  --node-id {{ inventory_hostname }} \
  --tls \
  --cert {{ cca_cert_dir }}/api-server-identity-certificate.pem \
  --key {{ cca_cert_dir }}/api-server-identity-certificate-key.pem \
  --ca {{ cca_cert_dir }}/cluster-identity-ca.pem \
  --ca-key {{ cca_cert_dir }}/cluster-identity-ca-key.pem \
  --gate-ca-cert {{ cca_cert_dir }}/gate-https-ca.pem \
  --gate-ca-key {{ cca_cert_dir }}/gate-https-ca-key.pem \
  --etcd-cert {{ cca_cert_dir }}/cca-server-etcd-client-certificate.pem \
  --etcd-key {{ cca_cert_dir }}/cca-server-etcd-client-certificate-key.pem \
  --etcd-ca {{ cca_cert_dir }}/etcd-access-ca.pem \
  --etcd-access-ca-key {{ cca_cert_dir }}/etcd-access-ca-key.pem \
  --control-plane-node-cert {{ cca_cert_dir }}/node-identity-for-api.pem \
  --dns --dns-listen {{ ansible_host }}:15353 \
  --cluster-cidr {{ cluster_cidr }} \
  --vip-cidr {{ vip_cidr }}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cca-server

[Install]
WantedBy=multi-user.target
