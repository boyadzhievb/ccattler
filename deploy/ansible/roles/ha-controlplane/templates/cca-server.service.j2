[Unit]
Description=CCattler Server — {{ inventory_hostname }} (HA)
After=network.target etcd.service
# Wants, not Requires: Requires stops cca-server whenever the local etcd
# stops and never starts it again; cca-server reaches the other etcd members
# and retries on its own (found by the M219 HA run, check 9).
Wants=etcd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/cca server \
  --listen {{ ansible_host }}:9770 \
  --node-id {{ inventory_hostname }} \
  --tls \
  --cert {{ cca_cert_dir }}/{{ cca_pki.server_cert }} \
  --key {{ cca_cert_dir }}/{{ cca_pki.server_key }} \
  --ca {{ cca_cert_dir }}/{{ cca_pki.cluster_ca }} \
  --ca-key {{ cca_cert_dir }}/{{ cca_pki.cluster_ca_key }} \
{% if cca_pki_layout == 'three_ca' %}
  --gate-ca-cert {{ cca_cert_dir }}/{{ cca_pki.gate_ca }} \
  --gate-ca-key {{ cca_cert_dir }}/{{ cca_pki.gate_ca_key }} \
  --etcd-cert {{ cca_cert_dir }}/{{ cca_pki.server_etcd_cert }} \
  --etcd-key {{ cca_cert_dir }}/{{ cca_pki.server_etcd_key }} \
  --etcd-ca {{ cca_cert_dir }}/{{ cca_pki.etcd_ca }} \
  --etcd-access-ca-key {{ cca_cert_dir }}/{{ cca_pki.etcd_ca_key }} \
  --control-plane-node-cert {{ cca_cert_dir }}/{{ cca_pki.node_cert }} \
{% endif %}
  --dns --dns-listen {{ ansible_host }}:15353 \
  --cluster-cidr {{ cluster_cidr }} \
  --vip-cidr {{ vip_cidr }}
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cca-server

[Install]
WantedBy=multi-user.target
