service web {
    image nginx:1.27
    instances 4

    expose 8080

    health {
        http /health
        every 10s
    }

    resources {
        cpu 500m
        memory 256Mi
    }
}

service api {
    image my-api:latest
    instances 2

    expose 3000

    resources {
        cpu 250m
        memory 128Mi
    }
}
