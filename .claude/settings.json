{
  "mcpServers": {
    "ccattler-remote": {
      "command": "ssh",
      "args": [
        "-i", "~/.ssh/id_rsa_lenovo_bojan",
        "-o", "StrictHostKeyChecking=no",
        "bojan@192.168.100.43",
        "/home/bojan/ccattler/ccattler-mcp --repo /home/bojan/ccattler --token-file /tmp/ccattler-mcp-token --audit-log /tmp/ccattler-mcp-audit.jsonl"
      ]
    }
  },
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/lint-naming.sh $CLAUDE_FILE_PATH 2>&1 | head -20"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/log-command.sh"
          }
        ]
      }
    ]
  }
}
