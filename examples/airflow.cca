# Apache Airflow: CeleryExecutor stack with PostgreSQL + Redis.
#
# Deploys a production-style Airflow cluster: metadata database, message
# broker, webserver, scheduler, and workers. Mirrors the official Helm
# chart architecture (https://airflow.apache.org/docs/helm-chart/stable/).
#
# Before deploying, create the required secrets:
#   cca secret set airflow.db-password <database-password>
#   cca secret set airflow.admin-password <admin-password>
#
# Run with:  cca run-container examples/airflow.cca
#
# After startup, access Airflow web UI at http://localhost:8080
#
# Components:
#   metadata-db     PostgreSQL 16 — metadata store
#   redis           Redis 7 — Celery broker
#   webserver       Airflow webserver — UI + REST API (runs db migrate on start)
#   scheduler       Airflow scheduler — DAG parsing + task scheduling
#   worker          Airflow Celery worker — task execution (scalable)

volume metadata-db-data {
    size 20Gi
    persistent true
}

volume redis-data {
    size 5Gi
    persistent true
}

volume dags {
    size 10Gi
    persistent true
}

volume logs {
    size 20Gi
    persistent true
}

service metadata-db {
    image postgres:16
    instances 1
    expose 5432
    resources {
        cpu 500m
        memory 512Mi
    }
    volume metadata-db-data /var/lib/postgresql/data
    config {
        env POSTGRES_DB "airflow"
        env POSTGRES_USER "airflow"
        env POSTGRES_PASSWORD_FILE "/run/secrets/db-password"
    }
    secret airflow.db-password "/run/secrets/db-password"
    health {
        tcp
        every 10s
    }
    init {
        exec "pg_isready -U airflow"
        timeout 60s
        retry 10
    }
}

service redis {
    image redis:7
    instances 1
    expose 6379
    resources {
        cpu 250m
        memory 256Mi
    }
    volume redis-data /data
    health {
        tcp
        every 10s
    }
}

service webserver {
    image "apache/airflow:2.10.5"
    command "bash -c 'airflow db migrate && airflow users create --username admin --password \"$(cat /run/secrets/admin-password)\" --firstname Admin --lastname User --role Admin --email admin@localhost; exec airflow webserver'"
    instances 1
    expose 8080
    resources {
        cpu 500m
        memory 1024Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "echo postgresql+psycopg2://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "echo db+postgresql://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__WEBSERVER__EXPOSE_CONFIG "false"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
    }
    secret airflow.db-password "/run/secrets/db-password"
    secret airflow.admin-password "/run/secrets/admin-password"
    secret fernet-key "/opt/airflow/fernet-key"
    secret webserver-secret-key "/opt/airflow/webserver-secret-key"
    health {
        http /health
        every 15s
    }
}

service scheduler {
    image "apache/airflow:2.10.5"
    command "airflow scheduler"
    instances 1
    resources {
        cpu 500m
        memory 1024Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "echo postgresql+psycopg2://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "echo db+postgresql://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
    }
    secret airflow.db-password "/run/secrets/db-password"
    secret fernet-key "/opt/airflow/fernet-key"
    health {
        tcp
        every 30s
    }
}

service worker {
    image "apache/airflow:2.10.5"
    command "airflow celery worker"
    instances 3
    expose 8793
    resources {
        cpu 1000m
        memory 2048Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "echo postgresql+psycopg2://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "echo db+postgresql://airflow:$(cat /run/secrets/db-password)@metadata-db:5432/airflow"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
    }
    secret airflow.db-password "/run/secrets/db-password"
    secret fernet-key "/opt/airflow/fernet-key"
    health {
        tcp
        every 15s
    }
    scale {
        horizontal {
            min 1
            max 10
            target cpu = 70
        }
    }
}

group airflow-stack {
    process webserver
    process scheduler
    process worker
    share volume dags
    share volume logs
}
