# Apache Airflow: CeleryExecutor stack with PostgreSQL + Redis.
#
# Deploys a production-style Airflow cluster: metadata database, message
# broker, webserver, scheduler, and workers. Mirrors the official Docker
# Compose architecture (https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/).
#
# Connection blocks define structured DB URLs that the agent assembles at
# runtime from secret + fields. Airflow reads them via _CMD = "cat ...".
#
# Before deploying, create the required secrets:
#   cca secret set airflow.db-password <database-password>
#   cca secret set airflow.admin-password <admin-password>
#
# Run with:  cca run-container examples/airflow.cca
#
# After startup, access Airflow web UI at http://localhost:8080
#
# Components:
#   metadata-db     PostgreSQL 16 — metadata store
#   redis           Redis 7 — Celery broker
#   webserver       Airflow webserver — UI + REST API (runs db migrate on start)
#   scheduler       Airflow scheduler — DAG parsing + task scheduling
#   worker          Airflow Celery worker — task execution (scalable)

connection airflow-db {
    driver "postgresql+psycopg2"
    user "airflow"
    secret airflow.db-password
    host "metadata-db"
    port 5432
    database "airflow"
}

connection airflow-celery-backend {
    driver "db+postgresql"
    user "airflow"
    secret airflow.db-password
    host "metadata-db"
    port 5432
    database "airflow"
}

volume metadata-db-data {
    size 20Gi
    persistent true
}

volume redis-data {
    size 5Gi
    persistent true
}

volume dags {
    size 10Gi
    persistent true
}

volume logs {
    size 20Gi
    persistent true
}

service metadata-db {
    image postgres:16
    instances 1
    expose 5432
    resources {
        cpu 500m
        memory 512Mi
    }
    volume metadata-db-data /var/lib/postgresql/data
    config {
        env POSTGRES_DB "airflow"
        env POSTGRES_USER "airflow"
        env POSTGRES_PASSWORD_FILE "/run/secrets/db-password"
    }
    secret airflow.db-password "/run/secrets/db-password"
    health {
        tcp
        every 10s
    }
}

service redis {
    image redis:7
    instances 1
    expose 6379
    resources {
        cpu 250m
        memory 256Mi
    }
    volume redis-data /data
    health {
        tcp
        every 10s
    }
}

service webserver {
    image "apache/airflow:2.10.5"
    command "webserver"
    instances 1
    expose 8080
    resources {
        cpu 500m
        memory 1024Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__WEBSERVER__EXPOSE_CONFIG "false"
        env AIRFLOW__WEBSERVER__SECRET_KEY_CMD "cca-secret airflow.webserver-secret-key"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
        env _AIRFLOW_DB_MIGRATE "true"
        env _AIRFLOW_WWW_USER_CREATE "true"
        env _AIRFLOW_WWW_USER_PASSWORD_CMD "cca-secret airflow.admin-password"
    }
    secret airflow.admin-password "/run/secrets/admin-password"
    secret fernet-key "/opt/airflow/fernet-key"
    secret webserver-secret-key "/opt/airflow/webserver-secret-key"
    health {
        http /health
        every 15s
    }
}

service scheduler {
    image "apache/airflow:2.10.5"
    command "scheduler"
    instances 1
    resources {
        cpu 500m
        memory 1024Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
    }
    secret fernet-key "/opt/airflow/fernet-key"
    init {
        exec "airflow db check"
        timeout 120s
        retry 20
    }
    startup {
        exec "airflow jobs check --job-type SchedulerJob --local"
        every 10s
        timeout 20s
        failure_threshold 6
    }
    liveness {
        exec "airflow jobs check --job-type SchedulerJob --local"
        every 60s
        timeout 20s
        failure_threshold 5
        initial_delay 10s
    }
}

service worker {
    image "apache/airflow:2.10.5"
    command "celery worker"
    instances 3
    expose 8793
    termination_grace_period 600s
    resources {
        cpu 1000m
        memory 2048Mi
    }
    volume dags /opt/airflow/dags
    volume logs /opt/airflow/logs
    connection airflow-db "/run/connections/airflow-db"
    connection airflow-celery-backend "/run/connections/airflow-celery-backend"
    config {
        env AIRFLOW__CORE__EXECUTOR "CeleryExecutor"
        env AIRFLOW__DATABASE__SQL_ALCHEMY_CONN_CMD "cat /run/connections/airflow-db"
        env AIRFLOW__CELERY__BROKER_URL "redis://redis:6379/0"
        env AIRFLOW__CELERY__RESULT_BACKEND_CMD "cat /run/connections/airflow-celery-backend"
        env AIRFLOW__CORE__LOAD_EXAMPLES "true"
        env AIRFLOW__CORE__FERNET_KEY_CMD "cca-secret airflow.fernet-key"
        env AIRFLOW__CORE__DAGS_FOLDER "/opt/airflow/dags"
        env AIRFLOW__LOGGING__BASE_LOG_FOLDER "/opt/airflow/logs"
    }
    secret fernet-key "/opt/airflow/fernet-key"
    init {
        exec "airflow db check"
        timeout 120s
        retry 20
    }
    startup {
        exec "celery --app airflow.providers.celery.executors.celery_executor.app inspect ping -d celery@$(hostname)"
        every 10s
        timeout 10s
        failure_threshold 18
        initial_delay 30s
    }
    liveness {
        exec "celery --app airflow.providers.celery.executors.celery_executor.app inspect ping -d celery@$(hostname)"
        every 60s
        timeout 20s
        failure_threshold 5
        initial_delay 30s
    }
    scale {
        horizontal {
            min 1
            max 10
            target cpu = 70
        }
    }
}

group airflow-stack {
    process webserver
    process scheduler
    process worker
    share volume dags
    share volume logs
}
