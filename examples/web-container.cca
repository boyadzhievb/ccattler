# Container deployment with config file and networking.
#
# Demonstrates: real Docker containers, config file mounting, cluster-network
#               IP allocation, exposed port.
# Run with:  cca run-container examples/web-container.cca
#
# Expected: 2 nginx instances, each with a custom index.html mounted via config,
#           allocated IPs from 10.100.x.y subnet, port 80 exposed.

service web {
    image nginx:1.28
    instances 2
    expose 80
    resources {
        cpu 500m
        memory 512Mi
    }
    config {
        file "/usr/share/nginx/html/index.html" "<!DOCTYPE html><html><body><h1>Hello from CCattler</h1><p>Container: <!--#echo var='HOSTNAME' --></p></body></html>"
        file "/etc/nginx/conf.d/ssi.conf" "server { listen 80; location / { ssi on; root /usr/share/nginx/html; } }"
    }
}
