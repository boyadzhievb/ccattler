# Production environment: full resources, autoscaling, no examples.

airflow.image: apache/airflow:2.10.5
airflow.loadExamples: false

webserver.instances: 2
webserver.cpu: 1000m
webserver.memory: 2048Mi

scheduler.cpu: 1000m
scheduler.memory: 2048Mi

worker.instances: 5
worker.cpu: 2000m
worker.memory: 4096Mi
worker.minInstances: 3
worker.maxInstances: 20
worker.cpuTarget: 60
