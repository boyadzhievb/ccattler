# Multiple services with different resource profiles.
#
# Demonstrates: two independent services, different instance counts,
#               different ports, different resource allocations.
# Run with:  cca apply examples/multi-service.ccattler
#
# Expected: web gets 4 instances spread across nodes, api gets 2.
#           Each service has its own resource footprint.

service web {
    image nginx:1.28
    instances 4
    expose 8080
    resources {
        cpu 500m
        memory 512Mi
    }
}

service api {
    image myapp:latest
    instances 2
    expose 3000
    resources {
        cpu 250m
        memory 256Mi
    }
}
